      ['åŠ¡å® æ–°æœºä¼š ç§å­', 'å¹³è¡¡ é€‚åº” å˜é€š', 'å›¢é˜Ÿ æŠ€è‰º åˆä½œ', 'å®ˆè´¢ å®‰å…¨ æ§åˆ¶', 'å›°éš¾ å­¤ç«‹ ä¿¡ä»°', 'ç»™äºˆ åˆ†äº« å›é¦ˆ', 'è¯„ä¼° è€å¿ƒ ç­‰å¾…', 'ç²¾è¿› ä¸“æ³¨ é‡å¤', 'æ”¶è· å¥¢ä¾ˆ ç‹¬ç«‹', 'ä¼ æ‰¿ å¯Œè¶³ å®¶æ—', 'å­¦ä¹  è¸å® æ–°è´¢åŠ¡', 'æ•ˆç‡ è´£ä»» å¯é ', 'åŠ¡å® æ»‹å…» æ…·æ…¨', 'å¯Œè¶³ ç¨³å¥ äº«å—']
    ];
    const reverseds: string[][] = [
      ['æƒ…æ„Ÿå°é—­ ä¸æ»¡è¶³', 'å¤±è¡¡ åˆ†ç¦» ä¸å’Œ', 'å­¤ç‹¬ æ‚²ä¼¤ å–æ¶ˆ', 'åŒå€¦ è´ªå©ª ä¸çŸ¥è¶³', 'æ— æ³•æ”¾æ‰‹ é‡è¹ˆè¦†è¾™', 'ä¸æˆç†Ÿ è‡ªç§ è´ªå©ª', 'é€ƒé¿ç°å® æ··ä¹±', 'é€€ç¼© æŠ—æ‹’ åœæ»', 'ä¸æ»¡è¶³ å¹»æƒ³ç ´ç­', 'å®¶åº­ä¸å’Œ æ„Ÿæƒ…ç ´è£‚', 'æƒ…ç»ªåŒ– å»¶è¿Ÿ', 'å–„å˜ ä¸çœŸè¯š', 'ä¾èµ– æƒ…ç»ªå‹’ç´¢', 'å†·æ¼  æ§åˆ¶æ¬²'],
      ['æ‹–å»¶ ç¼ºä¹æ–¹å‘', 'ä¼˜æŸ”å¯¡æ–­ è®¡åˆ’ä¸å‘¨', 'å†’è¿› ç›®å…‰çŸ­æµ…', 'ä¸ç¨³ æ‹–å»¶ æœªå°½', 'ä¸å’Œè° å†…æ–— å¤±è´¥', 'éª„å‚² å«‰å¦’ æŒ«è´¥', 'å¦¥å ç–²æƒ« åŠ¨æ‘‡', 'æ··ä¹± æ‹–å»¶ åœæ»', 'å›ºæ‰§ æœ€åå…³å¤´æ”¾å¼ƒ', 'å¸ä¸‹é‡æ‹… é€ƒé¿', 'åæ¶ˆæ¯ é²è½', 'æ€¥èº ç¼ºä¹è€å¿ƒ', 'ä¸“æ¨ª ç¼ºä¹åŒç†å¿ƒ', 'å†²åŠ¨ çŸ­è§†'],
      ['æ··ä¹± æ¨¡ç³Š é”™è¯¯', 'çŠ¹è±« ä¿¡æ¯è¿‡è½½', 'æ¢å¤ é‡Šæ€€ æ¥å—', 'ä¸å®‰ æ’æ–¥ä¼‘æ¯', 'é€†è¢­ å¸å–æ•™è®­', 'æ— æ³•å‘Šåˆ« æ²‰æºº', 'æš´éœ² è®¡åˆ’æ³„éœ²', 'è‡ªç”± é‡Šæ”¾ çªç ´', 'ææƒ§æ¶ˆé€€ çœŸç›¸æµ®ç°', 'æ— æ³•æ”¾æ‰‹ ç—›è‹¦å»¶é•¿', 'å¤šç–‘ è¿‡åº¦åˆ†æ', 'é²è½ å”çª', 'å†·æ¼  åˆ»è–„', 'ä¸å…¬ åè§'],
      ['é”™å¤±æœºä¼š ä¸ç¨³å®š', 'å¤±è¡¡ æ…Œä¹± æ‰“è½¬', 'ç¼ºä¹åˆä½œ å†…è€—', 'åå•¬ ææƒ§å¤±å»', 'èµ°å‡ºå›°å¢ƒ é‡æ‹¾ä¿¡å¿ƒ', 'è´ªå©ª åå•¬ äºæŸ', 'ç„¦è™‘ æ€¥èº æŠ•èµ„å¤±è´¥', 'ç¼ºä¹ä¸“æ³¨ è’åºŸ', 'è¿‡åº¦å·¥ä½œ å‹åŠ›', 'é—äº§çº çº· è´Ÿæ‹…', 'æµ…å°è¾„æ­¢ è´ªç©', 'ä¸è´Ÿè´£ä»» æ•£æ¼«', 'å¿½ç•¥è‡ªå·± è¿‡åº¦ç‰ºç‰²', 'ç‰©è´¨ä¸»ä¹‰ è´ªå©ª']
    ];

    let idx = 22;
    for (let s = 0; s < 4; s++) {
      for (let r = 0; r < 14; r++) {
        const sType = s + 1;
        const name = suits[s][0] + ranks[r];
        const nameEn = ranks[r] + ' of ' + suits[s][1];
        const upright = uprights[s][r];
        const reversed = reverseds[s][r];
        const keywords = suits[s][0] + ' ' + ranks[r];
        cards.push(new TarotCard(idx, name, nameEn, sType, upright, reversed, keywords, elements[s]));
        idx++;
      }
    }
    return cards;
  }
}
